+++ b/runtime/docker/management.go
@@ -0,0 +1,57 @@
+package docker
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/srl-labs/containerlab/internal/mgmtlink"
+	clabruntime "github.com/srl-labs/containerlab/runtime"
+	"net"
+	"strings"
+)
+
+const managementLabel = "netopsbench.management.v1"
+
+type managementMetadata struct {
+	clabruntime.GenericMgmtIPs
+	Network string
+	Bridge  string
+	Host    string
+	Alias   string
+}
+
+func parseManagement(raw string) (managementMetadata, error) {
+	var m managementMetadata
+	if e := json.Unmarshal([]byte(raw), &m); e != nil {
+		return m, e
+	}
+	ip := net.ParseIP(m.IPv4addr)
+	gw := net.ParseIP(m.IPv4Gw)
+	if ip == nil || ip.To4() == nil || gw == nil || m.IPv4pLen < 1 || m.IPv4pLen > 30 || m.Network == "" || !strings.HasPrefix(m.Bridge, "br-") || !strings.HasPrefix(m.Host, "nbm") || len(m.Host) > 15 || !strings.HasPrefix(m.Alias, "netopsbench-mgmt:") {
+		return m, fmt.Errorf("invalid external management metadata")
+	}
+	n := net.IPNet{IP: ip, Mask: net.CIDRMask(m.IPv4pLen, 32)}
+	if !n.Contains(gw) {
+		return m, fmt.Errorf("gateway outside management subnet")
+	}
+	return m, nil
+}
+func (d *DockerRuntime) attachManagement(ctx context.Context, id, raw string) error {
+	m, e := parseManagement(raw)
+	if e != nil {
+		return e
+	}
+	c, e := d.Client.ContainerInspect(ctx, id)
+	if e != nil {
+		return e
+	}
+	if c.State == nil || !c.State.Running {
+		return fmt.Errorf("management container not running")
+	}
+	b, e := mgmtlink.Birth(c.State.Pid)
+	if e != nil {
+		return e
+	}
+	_, e = mgmtlink.Run(mgmtlink.Request{Mode: "ensure", PID: c.State.Pid, Birth: b, Host: m.Host, Bridge: m.Bridge, CIDR: fmt.Sprintf("%s/%d", m.IPv4addr, m.IPv4pLen), Gateway: m.IPv4Gw, Alias: m.Alias})
+	return e
+}
