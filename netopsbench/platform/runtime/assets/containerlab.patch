+			c, counts := stageFixture(t)
+			if !c.canStageDirectVeth(false) {
+				t.Fatal("eligible fixture rejected")
+			}
+			wg, _, fail, e := c.createNodes(context.Background(), workers, false)
+			if e != nil {
+				t.Fatal(e)
+			}
+			done := make(chan struct{})
+			go func() { wg.Wait(); close(done) }()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("scheduler deadlock")
+			}
+			close(fail)
+			for e := range fail {
+				t.Error(e)
+			}
+			if counts.created.Load() != 6 || counts.linked.Load() != 6 || counts.post.Load() != 6 || counts.exec.Load() != 6 {
+				t.Fatal("lifecycle skipped")
