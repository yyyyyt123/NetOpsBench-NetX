+	}
+	counters := &directStageCounters{total: 6, staticTotal: 3}
+	for i := 0; i < 6; i++ {
+		name := fmt.Sprint(i)
+		cfg := &clabtypes.NodeConfig{ShortName: name, Stages: clabtypes.NewStages()}
+		if i < 3 {
+			cfg.MgmtIPv4Address = fmt.Sprintf("192.0.2.%d", i+1)
+		}
+		c.Nodes[name] = &directStageNode{cfg: cfg, counts: counters}
+	}
+	return c, counters
+}
