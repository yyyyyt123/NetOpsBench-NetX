+package sonic
+
+import (
+	clabnodes "github.com/srl-labs/containerlab/nodes"
+	clabruntime "github.com/srl-labs/containerlab/runtime"
+	clabtypes "github.com/srl-labs/containerlab/types"
+	"testing"
+)
+
+type endpointTestRuntime struct{ clabruntime.ContainerRuntime }
+
+func (*endpointTestRuntime) GetName() string { return "docker" }
+
+func TestDeferredSonicEndpointScope(t *testing.T) {
+	t.Setenv("CLAB_VETH_MODE", "both")
+	t.Setenv("CLAB_SONIC_DATA_DOWN", "on")
+	s := &sonic{DefaultNode: clabnodes.DefaultNode{Cfg: &clabtypes.NodeConfig{}, Runtime: &endpointTestRuntime{}}}
+	for _, name := range []string{"eth1", "eth12", "eth144"} {
+		if !s.DeferEndpointActivation(name) {
+			t.Fatalf("data interface not deferred: %s", name)
+		}
+	}
+	for _, name := range []string{"eth0", "lo", "mgmt0", "eth-1", "eth01", "eth", "Ethernet0"} {
+		if s.DeferEndpointActivation(name) {
+			t.Fatalf("non-data interface deferred: %s", name)
+		}
+	}
+	s.Cfg.Env = map[string]string{"RESTORE_SNAPSHOT": "yes"}
+	if s.DeferEndpointActivation("eth1") {
+		t.Fatal("snapshot behavior changed")
+	}
+	s.Cfg.Env = nil
+	s.Cfg.NetworkMode = "host"
+	if s.DeferEndpointActivation("eth1") {
+		t.Fatal("host namespace behavior changed")
+	}
+	s.Cfg.NetworkMode = ""
+	t.Setenv("CLAB_VETH_MODE", "first")
+	if s.DeferEndpointActivation("eth1") {
+		t.Fatal("non-staged deployment changed")
+	}
+	t.Setenv("CLAB_VETH_MODE", "both")
+	t.Setenv("CLAB_SONIC_DATA_DOWN", "off")
+	if s.DeferEndpointActivation("eth1") {
+		t.Fatal("explicit rollback ignored")
+	}
+}
