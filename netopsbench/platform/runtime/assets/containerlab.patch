@@ -0,0 +1,30 @@
+package sonic
+
+import (
+	"context"
+	_ "embed"
+	"fmt"
+	clabexec "github.com/srl-labs/containerlab/exec"
+	"time"
+)
+
+//go:embed direct_startup_wait.py
+var directStartupScript string
+
+// One bounded in-container waiter replaces repeated Docker exec and Python
+// supervisorctl startup. Hold the slot until services and expected SAI ports are ready.
+func (s *sonic) WaitDirectVethStartup(ctx context.Context) error {
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Minute)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	result, err := s.RunExec(ctx, clabexec.NewExecCmdFromSlice([]string{"python3", "-c", directStartupScript}))
+	if err != nil {
+		return err
+	}
+	if result.GetReturnCode() != 0 {
+		return fmt.Errorf("SONiC bootstrap waiter exited %d: %s", result.GetReturnCode(), result.GetStdErrString())
+	}
+	return nil
+}
