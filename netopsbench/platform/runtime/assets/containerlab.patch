new file mode 100644
--- /dev/null
+++ b/core/node_queries.go
@@ -0,0 +1,62 @@
+package core
+
+import (
+	"context"
+	clabnodes "github.com/srl-labs/containerlab/nodes"
+	"sort"
+	"sync"
+)
+
+const nodeQueryWorkers = 16
+
+// collectNodeQueries preserves each node's implementation, bounds in-flight work,
+// and joins all workers before returning. Node methods must honor ctx themselves.
+func collectNodeQueries[T any](ctx context.Context, nodes map[string]clabnodes.Node, query func(context.Context, clabnodes.Node) (T, error)) ([]T, error) {
+	names := make([]string, 0, len(nodes))
+	for name := range nodes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	values := make([]T, len(names))
+	workCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var firstErr error
+	next := 0
+	for i := 0; i < min(nodeQueryWorkers, len(names)); i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				mu.Lock()
+				if workCtx.Err() != nil || next >= len(names) {
+					mu.Unlock()
+					return
+				}
+				index := next
+				next++
+				mu.Unlock()
+				value, err := query(workCtx, nodes[names[index]])
+				if err != nil {
+					mu.Lock()
+					if firstErr == nil {
+						firstErr = err
+					}
+					mu.Unlock()
+					cancel()
+					return
+				}
+				values[index] = value
+			}
+		}()
+	}
+	wg.Wait()
+	if firstErr != nil {
+		return values, firstErr
+	}
+	if err := ctx.Err(); err != nil {
+		return values, err
+	}
+	return values, nil
+}
