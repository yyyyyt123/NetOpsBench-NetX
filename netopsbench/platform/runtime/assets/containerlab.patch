+func TestNodeQueriesBoundAndSemantics(t *testing.T) {
+	var active, peak, calls atomic.Int32
+	gate := make(chan struct{})
+	entered := make(chan struct{}, 64)
+	nodes := map[string]clabnodes.Node{}
+	for i := 0; i < 64; i++ {
+		name := fmt.Sprint(i)
+		nodes[name] = &queryNode{name: name, containers: func(ctx context.Context) ([]clabruntime.GenericContainer, error) {
+			calls.Add(1)
+			a := active.Add(1)
+			defer active.Add(-1)
+			for old := peak.Load(); a > old; old = peak.Load() {
+				if peak.CompareAndSwap(old, a) {
+					break
+				}
+			}
+			entered <- struct{}{}
+			select {
+			case <-gate:
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+			return []clabruntime.GenericContainer{{Names: []string{name}}}, nil
+		}}
+	}
+	done := make(chan error, 1)
+	go func() {
+		values, err := (&CLab{Nodes: nodes}).ListNodesContainers(context.Background())
+		if err == nil && len(values) != 64 {
+			err = fmt.Errorf("got %d", len(values))
+		}
+		done <- err
+	}()
+	for i := 0; i < 16; i++ {
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("workers not running")
+		}
+	}
+	if active.Load() != 16 {
+		t.Errorf("active %d", active.Load())
+	}
+	close(gate)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if peak.Load() > 16 || calls.Load() != 64 || active.Load() != 0 {
+		t.Fatalf("peak/calls/active %d/%d/%d", peak.Load(), calls.Load(), active.Load())
+	}
+}
