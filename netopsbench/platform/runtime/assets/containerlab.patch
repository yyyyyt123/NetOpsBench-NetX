+++ b/nodes/sonic/deferred_endpoint.go
@@ -0,0 +1,29 @@
+package sonic
+
+import (
+	"os"
+	"strconv"
+	"strings"
+
+	clablinks "github.com/srl-labs/containerlab/links"
+)
+
+// Experimental build-time switch. Standard builds preserve endpoint activation.
+var DataEndpointDownDefault = "off"
+
+// DeferEndpointActivation lets syncd own the first data-interface activation.
+// Management, restored snapshots and non-direct deployments retain old behavior.
+func (s *sonic) DeferEndpointActivation(iface string) bool {
+	mode := DataEndpointDownDefault
+	if value, ok := os.LookupEnv("CLAB_SONIC_DATA_DOWN"); ok {
+		mode = value
+	}
+	if mode != "on" || clablinks.DirectVethMode() != "both" || !s.SupportsDirectVeth() || s.Cfg.Env["RESTORE_SNAPSHOT"] != "" {
+		return false
+	}
+	if !strings.HasPrefix(iface, "eth") {
+		return false
+	}
+	index, err := strconv.Atoi(strings.TrimPrefix(iface, "eth"))
+	return err == nil && index > 0 && iface == "eth"+strconv.Itoa(index)
+}
