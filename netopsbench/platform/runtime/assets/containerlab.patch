+func TestDirectPhaseBoundCancelAndJoin(t *testing.T) {
+	var active, peak atomic.Int32
+	gate := make(chan struct{})
+	entered := make(chan struct{}, 20)
+	done := make(chan error, 1)
+	go func() {
+		done <- runDirectPhase(context.Background(), 3, make([]int, 20), func(context.Context, int) error {
+			a := active.Add(1)
+			defer active.Add(-1)
+			for p := peak.Load(); a > p; p = peak.Load() {
+				if peak.CompareAndSwap(p, a) {
+					break
+				}
+			}
+			entered <- struct{}{}
+			<-gate
+			return nil
+		})
+	}()
+	for i := 0; i < 3; i++ {
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("workers not started")
+		}
+	}
+	if active.Load() != 3 {
+		t.Fatal("wrong bound")
+	}
+	close(gate)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if peak.Load() > 3 || active.Load() != 0 {
+		t.Fatal("bound or join violation")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	err := runDirectPhase(ctx, 2, []int{1, 2, 3}, func(ctx context.Context, _ int) error {
+		active.Add(1)
+		defer active.Add(-1)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if !errors.Is(err, context.DeadlineExceeded) || active.Load() != 0 {
+		t.Fatal("timeout or join lost", err)
+	}
+	ctx, cancel = context.WithCancel(context.Background())
+	cancel()
+	if err := runDirectPhase(ctx, 1, []int{1}, func(context.Context, int) error { t.Fatal("called after cancellation"); return nil }); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
