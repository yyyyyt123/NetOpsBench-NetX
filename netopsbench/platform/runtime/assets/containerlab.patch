@@ -0,0 +1,12 @@
+package links
+
+// Endpoint activation is normally immediate. Opted-in nodes may defer it until
+// their own initialization, without changing link naming, ownership or offloads.
+type deferredEndpointNode interface {
+	DeferEndpointActivation(string) bool
+}
+
+func deferEndpointActivation(e Endpoint) bool {
+	owner, ok := e.GetNode().(deferredEndpointNode)
+	return ok && owner.DeferEndpointActivation(e.GetIfaceName())
+}
