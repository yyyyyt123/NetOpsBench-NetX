@@ -0,0 +1,37 @@
+package mgmtlink
+
+import (
+	"github.com/vishvananda/netlink"
+	"net"
+	"testing"
+)
+
+func TestDefaultRouteFormats(t *testing.T) {
+	_, zero, _ := net.ParseCIDR("0.0.0.0/0")
+	_, connected, _ := net.ParseCIDR("172.19.0.0/16")
+	gw := net.ParseIP("172.19.0.1")
+	for _, c := range []struct {
+		r    netlink.Route
+		want bool
+	}{{netlink.Route{Gw: gw}, true}, {netlink.Route{Gw: gw, Dst: zero}, true}, {netlink.Route{Gw: gw, Dst: connected}, false}, {netlink.Route{Dst: zero}, false}} {
+		if got := isDefaultGateway(c.r); got != c.want {
+			t.Fatalf("route %+v got %v", c.r, got)
+		}
+	}
+}
+func TestRejectUnownedInterface(t *testing.T) {
+	for _, name := range []string{"eth0", "docker0", "br-existing", "nbm-name-too-long"} {
+		if _, err := Run(Request{Mode: "delete", Host: name, Alias: "netopsbench-mgmt:test"}); err == nil {
+			t.Fatalf("accepted %s", name)
+		}
+	}
+}
+
+func TestManagementStableMAC(t *testing.T) {
+	a := stableMAC("netopsbench-mgmt:a")
+	b := stableMAC("netopsbench-mgmt:a")
+	c := stableMAC("netopsbench-mgmt:b")
+	if a.String() != b.String() || a.String() == c.String() || a[0]&3 != 2 {
+		t.Fatal("bad stable local unicast MAC")
+	}
+}
