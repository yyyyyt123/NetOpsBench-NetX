+package nodes
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	clabruntime "github.com/srl-labs/containerlab/runtime"
+)
+
+// DirectVethEligible is shared by the explicitly opted-in linux and sonic kinds.
+func (d *DefaultNode) DirectVethEligible() bool {
+	return d.Runtime != nil && d.Runtime.GetName() == "docker" && !d.Cfg.IsRootNamespaceBased &&
+		d.Cfg.NetworkMode != "host" && !strings.HasPrefix(d.Cfg.NetworkMode, "container:")
+}
+
+// OpenDirectVethNamespace preserves the existing joinable-container check. The
+// caller owns this handle and must close it on success and all failure paths.
+func (d *DefaultNode) OpenDirectVethNamespace(ctx context.Context) (ns.NetNS, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if !d.DirectVethEligible() {
+		return nil, fmt.Errorf("node %q is ineligible for direct veth", d.GetShortName())
+	}
+	status := d.OverwriteNode.GetContainerStatus(ctx)
+	if !clabruntime.ContainerHasJoinableNetns(status) {
+		return nil, fmt.Errorf("node %q: network namespace unavailable (status=%s)", d.GetShortName(), status)
+	}
+	path, err := d.OverwriteNode.GetNSPath(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return ns.GetNS(path)
+}
