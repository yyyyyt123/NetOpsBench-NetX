@@ -0,0 +1,36 @@
+package utils
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+)
+
+// ProfileDefault is overridden only in the isolated experiment build.
+var ProfileDefault = "0"
+var profileMu sync.Mutex
+
+func ProfileEnabled() bool {
+	v := os.Getenv("CLAB_PROFILE")
+	return v == "1" || (v == "" && ProfileDefault == "1")
+}
+
+// Profile records monotonic durations and UTC-aligned start times; no command arguments.
+func Profile(stage, node string) func() {
+	if !ProfileEnabled() {
+		return func() {}
+	}
+	start := time.Now()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			row := map[string]any{"stage": stage, "node": node, "start_unix_ns": start.UnixNano(), "duration_ns": time.Since(start).Nanoseconds()}
+			data, _ := json.Marshal(row)
+			profileMu.Lock()
+			defer profileMu.Unlock()
+			fmt.Fprintf(os.Stderr, "CLAB_PROFILE %s\n", data)
+		})
+	}
+}
