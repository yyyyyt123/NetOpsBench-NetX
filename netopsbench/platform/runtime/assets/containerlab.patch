diff --git a/core/direct_queues_test.go b/core/direct_queues_test.go
new file mode 100644
--- /dev/null
+++ b/core/direct_queues_test.go
@@ -0,0 +1,98 @@
+package core
+
+import (
+	"context"
+	"errors"
+	dm "github.com/srl-labs/containerlab/core/dependency_manager"
+	clabtypes "github.com/srl-labs/containerlab/types"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type queueWaiter struct {
+	*directStageNode
+	wait func(context.Context) error
+}
+
+func (n *queueWaiter) WaitDirectVethStartup(ctx context.Context) error { return n.wait(ctx) }
+func TestDirectQueuesIndependentProgress(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	ready, clientDone := make(chan struct{}), make(chan struct{})
+	client := dm.NewDependencyNode(&directStageNode{cfg: &clabtypes.NodeConfig{ShortName: "client1", Stages: clabtypes.NewStages()}})
+	sonic := dm.NewDependencyNode(&queueWaiter{directStageNode: &directStageNode{cfg: &clabtypes.NodeConfig{ShortName: "sonic1", Stages: clabtypes.NewStages()}}, wait: func(ctx context.Context) error {
+		close(ready)
+		select {
+		case <-clientDone:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}})
+	err := runDirectPostDeployLimit(ctx, 2, 1, []*dm.DependencyNode{client, sonic}, func(ctx context.Context, n *dm.DependencyNode) error {
+		if n == client {
+			select {
+			case <-ready:
+				close(clientDone)
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("client starved SONiC queue: %v", err)
+	}
+}
+
+func TestDirectQueuesCancelSiblingWaiter(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	ready := make(chan struct{})
+	failure := errors.New("client configuration failed")
+	client := dm.NewDependencyNode(&directStageNode{cfg: &clabtypes.NodeConfig{ShortName: "client1", Stages: clabtypes.NewStages()}})
+	sonic := dm.NewDependencyNode(&queueWaiter{directStageNode: &directStageNode{cfg: &clabtypes.NodeConfig{ShortName: "sonic1", Stages: clabtypes.NewStages()}}, wait: func(ctx context.Context) error { close(ready); <-ctx.Done(); return ctx.Err() }})
+	err := runDirectPostDeployLimit(ctx, 2, 1, []*dm.DependencyNode{client, sonic}, func(ctx context.Context, n *dm.DependencyNode) error {
+		if n == client {
+			select {
+			case <-ready:
+				return failure
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+		return nil
+	})
+	if !errors.Is(err, failure) || ctx.Err() != nil {
+		t.Fatalf("failure did not promptly cancel peer: %v", err)
+	}
+}
+
+func TestDirectQueuesShareRPCBudget(t *testing.T) {
+	var active, peak, calls atomic.Int32
+	nodes := []*dm.DependencyNode{}
+	for i := 0; i < 40; i++ {
+		n := &directStageNode{cfg: &clabtypes.NodeConfig{Stages: clabtypes.NewStages()}}
+		if i%2 == 0 {
+			nodes = append(nodes, dm.NewDependencyNode(&queueWaiter{directStageNode: n, wait: func(context.Context) error { return nil }}))
+		} else {
+			nodes = append(nodes, dm.NewDependencyNode(n))
+		}
+	}
+	err := runDirectPostDeployLimit(context.Background(), 3, 8, nodes, func(context.Context, *dm.DependencyNode) error {
+		a := active.Add(1)
+		defer active.Add(-1)
+		for p := peak.Load(); a > p; p = peak.Load() {
+			if peak.CompareAndSwap(p, a) {
+				break
+			}
+		}
+		calls.Add(1)
+		time.Sleep(time.Millisecond)
+		return nil
+	})
+	if err != nil || peak.Load() > 3 || calls.Load() != 40 || active.Load() != 0 {
+		t.Fatalf("RPC budget/work lost: %v peak=%d calls=%d", err, peak.Load(), calls.Load())
+	}
+}
diff --git a/core/direct_rolling_test.go b/core/direct_rolling_test.go
new file mode 100644
--- /dev/null
+++ b/core/direct_rolling_test.go
@@ -0,0 +1,62 @@
+package core
+
+import (
+	"context"
+	dm "github.com/srl-labs/containerlab/core/dependency_manager"
+	clabtypes "github.com/srl-labs/containerlab/types"
+	"testing"
+	"time"
+)
+
+type rollingTestNode struct {
+	*directStageNode
+	wait func(context.Context) error
+}
+
+func (n *rollingTestNode) WaitDirectVethStartup(ctx context.Context) error { return n.wait(ctx) }
+
+func TestDirectRollingDoesNotWaitForWholeWave(t *testing.T) {
+	gate := make(chan struct{})
+	defer close(gate)
+	thirdStarted := make(chan struct{}, 1)
+	var nodes []*dm.DependencyNode
+	for _, name := range []string{"slow", "fast", "third"} {
+		n := &rollingTestNode{directStageNode: &directStageNode{cfg: &clabtypes.NodeConfig{ShortName: name, Stages: clabtypes.NewStages()}}, wait: func(context.Context) error { return nil }}
+		if name == "slow" {
+			n.wait = func(ctx context.Context) error {
+				select {
+				case <-gate:
+					return nil
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+		}
+		nodes = append(nodes, dm.NewDependencyNode(n))
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	finished := make(chan error, 1)
+	go func() {
+		finished <- runDirectPostDeployLimit(ctx, 1, 2, nodes, func(ctx context.Context, n *dm.DependencyNode) error {
+			if n.GetShortName() == "third" {
+				thirdStarted <- struct{}{}
+			}
+			return nil
+		})
+	}()
+	select {
+	case <-thirdStarted:
+	case <-time.After(3 * time.Second):
+		t.Fatal("fast node failed to release its slot while slow node still waited")
+	}
+	cancel()
+	select {
+	case err := <-finished:
+		if err == nil {
+			t.Fatal("cancellation lost")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("workers not joined")
+	}
+}
diff --git a/core/direct_stages.go b/core/direct_stages.go
new file mode 100644
--- /dev/null
+++ b/core/direct_stages.go
@@ -0,0 +1,277 @@
+package core
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/charmbracelet/log"
+	dm "github.com/srl-labs/containerlab/core/dependency_manager"
+	clabexec "github.com/srl-labs/containerlab/exec"
+	clablinks "github.com/srl-labs/containerlab/links"
+	clabnodes "github.com/srl-labs/containerlab/nodes"
+	clabtypes "github.com/srl-labs/containerlab/types"
+	clabutils "github.com/srl-labs/containerlab/utils"
+)
+
+// Explicit stage hooks/dependencies and shared namespaces retain the original
+// scheduler. In particular, do not wait for a peer while holding the sole worker.
+func (c *CLab) canStageDirectVeth(skipPostDeploy bool) bool {
+	if skipPostDeploy || len(c.Nodes) == 0 {
+		return false
+	}
+	for _, n := range c.Nodes {
+		direct, ok := n.(clablinks.DirectVethNode)
+		if !ok || !direct.SupportsDirectVeth() {
+			return false
+		}
+		cfg := n.Config()
+		if cfg.StartupDelay != 0 || cfg.Env["RESTORE_SNAPSHOT"] != "" {
+			return false
+		}
+		s := cfg.Stages
+		if s == nil || s.Create == nil || s.CreateLinks == nil || s.Configure == nil || s.Healthy == nil || s.Exit == nil {
+			return false
+		}
+		for _, deps := range s.GetWaitFor() {
+			if len(deps) > 0 {
+				return false
+			}
+		}
+		if s.Create.Execs.HasCommands() || s.CreateLinks.Execs.HasCommands() || s.Configure.Execs.HasCommands() || s.Healthy.Execs.HasCommands() || s.Exit.Execs.HasCommands() {
+			return false
+		}
+	}
+	for _, link := range c.Links {
+		v, ok := link.(*clablinks.LinkVEth)
+		if !ok || !v.CanDirect() {
+			return false
+		}
+	}
+	return true
+}
+
+// runDirectPhase cancels siblings on failure, joins every in-flight operation,
+// and never starts the next phase until this one has finished successfully.
+func runDirectPhase[T any](ctx context.Context, workers int, items []T, fn func(context.Context, T) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if len(items) == 0 {
+		return nil
+	}
+	if workers <= 0 {
+		workers = len(items)
+	}
+	if workers > len(items) {
+		workers = len(items)
+	}
+	child, cancel := context.WithCancel(ctx)
+	defer cancel()
+	jobs := make(chan T)
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var errs []error
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for item := range jobs {
+				if child.Err() != nil {
+					continue
+				}
+				if err := fn(child, item); err != nil {
+					mu.Lock()
+					errs = append(errs, err)
+					mu.Unlock()
+					cancel()
+				}
+			}
+		}()
+	}
+enqueue:
+	for _, item := range items {
+		select {
+		case jobs <- item:
+		case <-child.Done():
+			break enqueue
+		}
+	}
+	close(jobs)
+	wg.Wait()
+	if len(errs) > 0 {
+		return errors.Join(errs...)
+	}
+	return ctx.Err()
+}
+
+// PostDeploy starts SONiC asynchronously. Bound unfinished bootstrap work as
+// well as Docker RPCs; otherwise even one worker can start 180 boot scripts at
+// once. This is an additional completion barrier, not a replacement for the
+// caller's service, routing and observability health checks.
+type directStartupWaiter interface {
+	WaitDirectVethStartup(context.Context) error
+}
+
+func runDirectPostDeploy(ctx context.Context, workers int, nodes []*dm.DependencyNode, configure func(context.Context, *dm.DependencyNode) error) error {
+	return runDirectPostDeployLimit(ctx, workers, 32, nodes, configure)
+}
+
+// A completed node immediately releases a bootstrap slot. Docker RPC concurrency
+// remains bounded independently; waiting for background startup holds no RPC slot.
+func runDirectPostDeployLimit(ctx context.Context, workers, startupWorkers int, nodes []*dm.DependencyNode, configure func(context.Context, *dm.DependencyNode) error) error {
+	if workers <= 0 {
+		workers = len(nodes)
+	}
+	if workers < 1 {
+		workers = 1
+	}
+	if startupWorkers < 1 {
+		return fmt.Errorf("bootstrap worker limit must be positive")
+	}
+	rpcSlots := make(chan struct{}, workers)
+	configureAndWait := func(ctx context.Context, n *dm.DependencyNode) error {
+		select {
+		case rpcSlots <- struct{}{}:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+		if err := ctx.Err(); err != nil {
+			<-rpcSlots
+			return err
+		}
+		err := configure(ctx, n)
+		<-rpcSlots
+		if err != nil {
+			return err
+		}
+		if waiter, ok := n.Node.(directStartupWaiter); ok {
+			defer clabutils.Profile("node_bootstrap_wait", n.GetShortName())()
+			if err := waiter.WaitDirectVethStartup(ctx); err != nil {
+				return fmt.Errorf("node %s bootstrap: %w", n.GetShortName(), err)
+			}
+		}
+		return nil
+	}
+	// Plain client configuration cannot consume SONiC bootstrap slots. Both
+	// queues still share the original Docker RPC budget and failure context.
+	var startup, plain []*dm.DependencyNode
+	for _, n := range nodes {
+		if _, ok := n.Node.(directStartupWaiter); ok {
+			startup = append(startup, n)
+		} else {
+			plain = append(plain, n)
+		}
+	}
+	type queue struct {
+		nodes   []*dm.DependencyNode
+		workers int
+	}
+	queues := []queue{{startup, startupWorkers}, {plain, min(4, workers)}}
+	return runDirectPhase(ctx, 2, queues, func(ctx context.Context, q queue) error {
+		return runDirectPhase(ctx, q.workers, q.nodes, configureAndWait)
+	})
+}
+
+func (c *CLab) scheduleDirectStages(ctx context.Context, workers int, fail chan<- error) (*sync.WaitGroup, *clabexec.ExecCollection) {
+	ec := clabexec.NewExecCollection()
+	wg := new(sync.WaitGroup)
+	wg.Add(1)
+	for _, link := range c.Links {
+		link.(*clablinks.LinkVEth).SetDirectMode("both")
+	}
+	var nodes, static, dynamic []*dm.DependencyNode
+	for _, n := range c.dependencyManager.GetNodes() {
+		nodes = append(nodes, n)
+	}
+	sort.Slice(nodes, func(i, j int) bool { return nodes[i].GetShortName() < nodes[j].GetShortName() })
+	for _, n := range nodes {
+		if n.Config().MgmtIPv4Address != "" || n.Config().MgmtIPv6Address != "" {
+			static = append(static, n)
+		} else {
+			dynamic = append(dynamic, n)
+		}
+	}
+	log.Info("Experimental direct veth scheduler: create namespaces and links, then independent SONiC/client queues (32 bootstrap slots, max 4 client workers, shared RPC limit, max 8 link workers)")
+	go func() {
+		defer wg.Done()
+		create := func(ctx context.Context, n *dm.DependencyNode) error {
+			n.EnterStage(ctx, clabtypes.WaitForCreate)
+			done := clabutils.Profile("node_predeploy", n.GetShortName())
+			err := n.PreDeploy(ctx, &clabnodes.PreDeployParams{Cert: c.Cert, TopologyName: c.Config.Name, TopoPaths: c.TopoPaths, SSHPubKeys: c.SSHPubKeys})
+			done()
+			if err != nil {
+				return fmt.Errorf("node %s predeploy: %w", n.GetShortName(), err)
+			}
+			done = clabutils.Profile("node_create", n.GetShortName())
+			err = n.Deploy(ctx, &clabnodes.DeployParams{Nodes: c.Nodes})
+			done()
+			if err != nil {
+				return fmt.Errorf("node %s create: %w", n.GetShortName(), err)
+			}
+			done = clabutils.Profile("node_runtime_info", n.GetShortName())
+			err = n.UpdateConfigWithRuntimeInfo(ctx)
+			done()
+			if err != nil {
+				return fmt.Errorf("node %s runtime info: %w", n.GetShortName(), err)
+			}
+			n.Done(ctx, clabtypes.WaitForCreate)
+			return nil
+		}
+		links := func(ctx context.Context, n *dm.DependencyNode) error {
+			n.EnterStage(ctx, clabtypes.WaitForCreateLinks)
+			defer clabutils.Profile("node_links", n.GetShortName())()
+			if err := n.DeployEndpoints(ctx); err != nil {
+				return fmt.Errorf("node %s links: %w", n.GetShortName(), err)
+			}
+			n.Done(ctx, clabtypes.WaitForCreateLinks)
+			return nil
+		}
+		configure := func(ctx context.Context, n *dm.DependencyNode) error {
+			n.EnterStage(ctx, clabtypes.WaitForConfigure)
+			done := clabutils.Profile("node_postdeploy", n.GetShortName())
+			err := n.PostDeploy(ctx, &clabnodes.PostDeployParams{Nodes: c.Nodes})
+			done()
+			if err != nil {
+				return fmt.Errorf("node %s postdeploy: %w", n.GetShortName(), err)
+			}
+			n.Done(ctx, clabtypes.WaitForConfigure)
+			done = clabutils.Profile("node_exec", n.GetShortName())
+			err = n.RunExecFromConfig(ctx, ec)
+			done()
+			if err != nil {
+				return fmt.Errorf("node %s exec: %w", n.GetShortName(), err)
+			}
+			return nil
+		}
+		for _, phase := range []struct {
+			name  string
+			items []*dm.DependencyNode
+			fn    func(context.Context, *dm.DependencyNode) error
+		}{
+			{"direct_stage_create_static", static, create}, {"direct_stage_create_dynamic", dynamic, create},
+			{"direct_stage_links", nodes, links},
+		} {
+			done := clabutils.Profile(phase.name, "")
+			phaseWorkers := workers
+			if phase.name == "direct_stage_links" && (phaseWorkers > 8 || phaseWorkers <= 0) {
+				phaseWorkers = 8
+			}
+			err := runDirectPhase(ctx, phaseWorkers, phase.items, phase.fn)
+			done()
+			if err != nil {
+				fail <- fmt.Errorf("%s: %w", phase.name, err)
+				return
+			}
+		}
+		done := clabutils.Profile("direct_stage_postdeploy", "")
+		err := runDirectPostDeploy(ctx, workers, nodes, configure)
+		done()
+		if err != nil {
+			fail <- fmt.Errorf("direct_stage_postdeploy: %w", err)
+		}
+	}()
+	return wg, ec
+}
