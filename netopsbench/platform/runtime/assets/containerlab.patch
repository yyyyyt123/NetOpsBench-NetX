+++ b/nodes/sonic/direct_startup_wait.py
@@ -0,0 +1,101 @@
+"""Bound actual SONiC initialization; routing/observation remain SDK checks."""
+import http.client
+import json
+import socket
+import time
+from pathlib import Path
+
+REQUIRED = ('redis-server', 'syncd', 'portsyncd', 'orchagent', 'zebra')
+
+
+def readiness(snapshot, expected):
+    processes = snapshot['processes']
+    boot = processes.get('start.sh', {})
+    for name in REQUIRED:
+        process = processes.get(name, {})
+        state = process.get('statename')
+        if state == 'FATAL' or (state == 'EXITED' and process.get('start', 0) > 0):
+            raise RuntimeError('Required service failed: ' + name + ':' + str(state))
+    state = boot.get('statename')
+    if state == 'EXITED' and boot.get('exitstatus') != 0:
+        raise RuntimeError('start.sh failed with exit status ' + str(boot.get('exitstatus')))
+    if state in ('FATAL', 'UNKNOWN'):
+        raise RuntimeError('Unexpected start.sh state: ' + str(state))
+    services_ok = all(processes.get(n, {}).get('statename') == 'RUNNING' for n in REQUIRED)
+    counters = snapshot.get('ports', {})
+    ports_ok = all(counters.get(p, '').startswith('oid:0x') and
+                   int(counters[p][6:], 16) != 0 for p in expected)
+    return (state == 'EXITED' and boot.get('exitstatus') == 0 and services_ok
+            and bool(snapshot.get('hostname')) and snapshot.get('configured_ports') == len(expected)
+            and snapshot.get('port_init_done', False) and ports_ok)
+
+
+def wait_for_bootstrap(probe, expected, timeout=115, interval=1, clock=time.monotonic,
+                       sleep=time.sleep, emit=lambda row: None):
+    if not expected:
+        raise ValueError('Expected PORT set must not be empty')
+    started = clock()
+    last = {}
+    while clock() - started < timeout:
+        try:
+            last = probe()
+        except (OSError, http.client.HTTPException) as error:
+            last = {'probe_error': type(error).__name__}
+        elapsed = clock() - started
+        emit(dict(elapsed=elapsed, **last))
+        if elapsed >= timeout:
+            break
+        if 'processes' in last and readiness(last, expected):
+            emit({'event': 'ready', 'elapsed': elapsed, 'expected_ports': sorted(expected)})
+            return
+        sleep(min(interval, max(0, timeout - (clock() - started))))
+    raise TimeoutError('SONiC initialization deadline exceeded; see /tmp/netopsbench-bootstrap-readiness.jsonl')
+
+
+def main():
+    import redis
+    from supervisor.options import ClientOptions
+    config = json.loads(Path('/etc/sonic/config_db.json').read_text())
+    expected = set(config.get('PORT', {}))
+    options = ClientOptions()
+    options.realize(args=[])
+    socket.setdefaulttimeout(2)
+    clients = {n: redis.Redis(host='127.0.0.1', port=6379, db=n, decode_responses=True,
+                             socket_connect_timeout=1, socket_timeout=1) for n in (0, 2, 4)}
+    def probe():
+        with options.getServerProxy() as proxy:
+            processes = {p['name']: {k: p[k] for k in ('statename', 'exitstatus', 'start', 'pid')}
+                         for p in proxy.supervisor.getAllProcessInfo()}
+        row = {'processes': processes}
+        try:
+            row['ports'] = clients[2].hgetall('COUNTERS_PORT_NAME_MAP')
+            pipe = clients[4].pipeline(transaction=False)
+            pipe.hget('DEVICE_METADATA|localhost', 'hostname')
+            for port in sorted(expected):
+                pipe.exists('PORT|' + port)
+            values = pipe.execute()
+            row.update(hostname=values[0], configured_ports=sum(values[1:]),
+                       port_init_done=bool(clients[0].exists('PORT_TABLE:PortInitDone')))
+        except redis.RedisError as error:
+            row['redis_error'] = type(error).__name__
+        return row
+    path = Path('/tmp/netopsbench-bootstrap-readiness.jsonl')
+    previous = None
+    last_write = 0
+    def emit(row):
+        nonlocal previous, last_write
+        comparison = {k: v for k, v in row.items() if k != 'elapsed'}
+        now = time.monotonic()
+        if comparison != previous or now-last_write >= 5:
+            with path.open('a') as f:
+                f.write(json.dumps(dict(utc=time.time(), **row))+'\n')
+            previous, last_write = comparison, now
+    try:
+        wait_for_bootstrap(probe, expected, emit=emit)
+    except Exception as error:
+        emit({'event': 'failed', 'error': str(error), 'error_type': type(error).__name__})
+        raise
+
+
+if __name__ == '__main__':
+    main()
