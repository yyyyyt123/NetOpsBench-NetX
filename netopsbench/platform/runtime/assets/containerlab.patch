+package links
+
+import (
+	"github.com/vishvananda/netlink"
+	"testing"
+)
+
+func TestParkingRemotePeerIndexCollision(t *testing.T) {
+	v := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: "eth1", Index: 3, ParentIndex: 3, NetNsID: 0}}
+	if !isOwnedInterface(v, map[string]struct{}{"eth1": {}}) {
+		t.Fatal("remote peer index collision rejected")
+	}
+	if isOwnedInterface(v, nil) {
+		t.Fatal("unowned interface accepted")
+	}
+	v.Name = "eth0"
+	if isOwnedInterface(v, map[string]struct{}{"eth0": {}}) {
+		t.Fatal("management interface parked")
+	}
+}
