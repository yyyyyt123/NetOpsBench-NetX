+package docker
+
+import (
+	clabutils "github.com/srl-labs/containerlab/utils"
+	"net/http"
+	"regexp"
+)
+
+var profileID = regexp.MustCompile(`/[a-f0-9]{64}(/|$)`)
+
+type profileTransport struct{ base http.RoundTripper }
+
+func (p *profileTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	// Paths only; never query values, bodies, headers, or credentials.
+	end := clabutils.Profile("docker_api "+r.Method+" "+profileID.ReplaceAllString(r.URL.Path, "/{id}$1"), "")
+	defer end()
+	return p.base.RoundTrip(r)
+}
