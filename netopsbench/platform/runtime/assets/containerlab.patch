@@ -0,0 +1,40 @@
+package docker
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+)
+
+type profileTestTransport func(*http.Request) (*http.Response, error)
+
+func (f profileTestTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestProfileTransportPreservesRequestAndResults(t *testing.T) {
+	request, _ := http.NewRequestWithContext(context.Background(), http.MethodGet, "http://localhost/containers/json?filters=private", nil)
+	response := &http.Response{StatusCode: 200}
+	sentinel := errors.New("transport failure")
+	for _, failure := range []error{nil, sentinel} {
+		transport := &profileTransport{base: profileTestTransport(func(got *http.Request) (*http.Response, error) {
+			if got != request {
+				t.Fatal("request identity changed")
+			}
+			return response, failure
+		})}
+		got, err := transport.RoundTrip(request)
+		if got != response || err != failure {
+			t.Fatal("response or error identity changed")
+		}
+	}
+}
+func TestProfileTransportPreservesCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	request, _ := http.NewRequestWithContext(ctx, http.MethodGet, "http://localhost/info", nil)
+	transport := &profileTransport{base: profileTestTransport(func(got *http.Request) (*http.Response, error) { return nil, got.Context().Err() })}
+	_, err := transport.RoundTrip(request)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
