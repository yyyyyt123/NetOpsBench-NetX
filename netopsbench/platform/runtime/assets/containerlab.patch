+package links
+
+import (
+	"context"
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+	"net"
+	"os"
+	"testing"
+)
+
+type deferredKernelNode struct{ *kernelDirectNode }
+
+func (*deferredKernelNode) DeferEndpointActivation(name string) bool { return name == "eth1" }
+
+func TestDeferredEndpointKernel(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("isolated namespace integration requires root")
+	}
+	l, a, b := kernelDirectPair(t)
+	l.Endpoints[0].SetNode(&deferredKernelNode{a})
+	l.SetDirectMode("both")
+	ctx := context.Background()
+	if err := l.Deploy(ctx, l.Endpoints[0]); err != nil {
+		t.Fatal(err)
+	}
+	if err := activateEndpoint(ctx, l.Endpoints[0]); err != nil {
+		t.Fatal(err)
+	}
+	for i, n := range []*kernelDirectNode{a, b} {
+		if err := n.ExecFunction(ctx, func(ns.NetNS) error {
+			ep := l.Endpoints[i]
+			link, err := netlink.LinkByName(ep.GetIfaceName())
+			if err != nil {
+				return err
+			}
+			attrs := link.Attrs()
+			if (attrs.Flags&net.FlagUp != 0) != (i == 1) {
+				t.Errorf("endpoint %d activation wrong: %v", i, attrs.Flags)
+			}
+			if attrs.MTU != 9500 || attrs.HardwareAddr.String() != ep.GetMac().String() || attrs.Alias != ep.GetIfaceAlias() || len(attrs.AltNames) < 2 {
+				t.Error("deferred endpoint lost configuration")
+			}
+			if i == 0 {
+				return netlink.LinkSetUp(link)
+			} // SONiC can activate later.
+			return nil
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := l.Remove(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/links/direct_veth.go b/links/direct_veth.go
new file mode 100644
--- /dev/null
+++ b/links/direct_veth.go
@@ -0,0 +1,156 @@
+package links
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/charmbracelet/log"
+	"github.com/containernetworking/plugins/pkg/ns"
+	clabutils "github.com/srl-labs/containerlab/utils"
+	"github.com/vishvananda/netlink"
+)
+
+// DirectVethDefault is an experimental build-time switch. Ordinary builds remain off.
+var DirectVethDefault = "off"
+
+func DirectVethMode() string {
+	if value, ok := os.LookupEnv("CLAB_VETH_MODE"); ok {
+		return value
+	}
+	return DirectVethDefault
+}
+
+// DirectVethNode is deliberately opt-in. Nodes with specialized attachment logic
+// retain AddLinkToContainer; embedding DefaultNode alone does not opt in.
+type DirectVethNode interface {
+	SupportsDirectVeth() bool
+	OpenDirectVethNamespace(context.Context) (ns.NetNS, error)
+}
+
+func (l *LinkVEth) CanDirect() bool {
+	if len(l.Endpoints) != 2 {
+		return false
+	}
+	for _, ep := range l.Endpoints {
+		node, ok := ep.GetNode().(DirectVethNode)
+		if !ok || !node.SupportsDirectVeth() || ep.IsNodeless() ||
+			ep.GetNode().GetLinkEndpointType() != LinkEndpointTypeVeth || !IsValidInterfaceName(ep.GetIfaceName()) {
+			return false
+		}
+	}
+	return true
+}
+
+// SetDirectMode is called during resolution, before concurrent link deployment.
+func (l *LinkVEth) SetDirectMode(mode string) bool {
+	if (mode != "first" && mode != "both") || !l.CanDirect() {
+		l.directMode = ""
+		return false
+	}
+	l.directMode = mode
+	return true
+}
+
+type directVethOps struct {
+	add    func(netlink.Link) error
+	find   func(string) (netlink.Link, error)
+	remove func(netlink.Link) error
+	txOff  func(string) error
+	setup  func(netlink.Link, Endpoint) func(ns.NetNS) error
+}
+
+func kernelDirectVethOps() *directVethOps {
+	return &directVethOps{netlink.LinkAdd, netlink.LinkByName, netlink.LinkDel, clabutils.EthtoolTXOff, SetNameMACAndUpInterface}
+}
+
+type directRollbackError struct{ error }
+
+func (l *LinkVEth) deployDirect(ctx context.Context, idx int) (retErr error) {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	ep, peer := l.Endpoints[idx], l.Endpoints[(idx+1)%2]
+	a, err := ep.GetNode().(DirectVethNode).OpenDirectVethNamespace(ctx)
+	if err != nil {
+		return err
+	}
+	defer a.Close()
+	var b ns.NetNS
+	both := l.directMode == "both"
+	if both {
+		b, err = peer.GetNode().(DirectVethNode).OpenDirectVethNamespace(ctx)
+		if err != nil {
+			return err
+		}
+		defer b.Close()
+	}
+	ops := l.directOps
+	if ops == nil {
+		ops = kernelDirectVethOps()
+	}
+	v := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: ep.GetIfaceName(), MTU: l.MTU, Namespace: netlink.NsFd(a.Fd())}, PeerName: peer.GetRandIfaceName()}
+	if both {
+		v.PeerName = peer.GetIfaceName()
+		v.PeerNamespace = netlink.NsFd(b.Fd())
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	done := clabutils.Profile("direct_veth_create", ep.String())
+	err = ops.add(v)
+	done()
+	if err != nil {
+		return err
+	} // A name collision must never delete an existing link.
+	defer func() {
+		if retErr == nil {
+			return
+		}
+		cleanupErr := a.Do(func(ns.NetNS) error {
+			created, err := ops.find(ep.GetIfaceName())
+			if err != nil {
+				return err
+			}
+			return ops.remove(created) // Deleting A also deletes B, wherever B resides.
+		})
+		if cleanupErr != nil {
+			retErr = &directRollbackError{errors.Join(retErr, fmt.Errorf("direct veth rollback: %w", cleanupErr))}
+		}
+	}()
+	setup := func(target ns.NetNS, endpoint Endpoint, stage string) error {
+		defer clabutils.Profile(stage, endpoint.String())()
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		return target.Do(func(current ns.NetNS) error {
+			link, err := ops.find(endpoint.GetIfaceName())
+			if err != nil {
+				return err
+			}
+			if err = ops.txOff(endpoint.GetIfaceName()); err != nil {
+				return err
+			}
+			return ops.setup(link, endpoint)(current)
+		})
+	}
+	if err = setup(a, ep, "direct_veth_setup_a"); err != nil {
+		return err
+	}
+	if both {
+		if err = setup(b, peer, "direct_veth_setup_b"); err != nil {
+			return err
+		}
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if both {
+		l.DeploymentState = LinkDeploymentStateFullDeployed
+		log.Infof("Created link: %s ▪┄┄▪ %s", l.Endpoints[0], l.Endpoints[1])
+	} else {
+		l.DeploymentState = LinkDeploymentStateHalfDeployed
+	}
+	return nil
+}
diff --git a/links/direct_veth_kernel_test.go b/links/direct_veth_kernel_test.go
new file mode 100644
--- /dev/null
+++ b/links/direct_veth_kernel_test.go
@@ -0,0 +1,230 @@
+package links
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"runtime"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netns"
+)
+
+type kernelDirectNode struct {
+	*fakeNode
+	handle netns.NsHandle
+}
+
+func (n *kernelDirectNode) SupportsDirectVeth() bool { return true }
+func (n *kernelDirectNode) OpenDirectVethNamespace(ctx context.Context) (ns.NetNS, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return ns.GetNS(fmt.Sprintf("/proc/self/fd/%d", n.handle))
+}
+func (n *kernelDirectNode) ExecFunction(ctx context.Context, f func(ns.NetNS) error) error {
+	h, e := n.OpenDirectVethNamespace(ctx)
+	if e != nil {
+		return e
+	}
+	defer h.Close()
+	return h.Do(f)
+}
+func (n *kernelDirectNode) AddLinkToContainer(ctx context.Context, l netlink.Link, f func(ns.NetNS) error) error {
+	h, e := n.OpenDirectVethNamespace(ctx)
+	if e != nil {
+		return e
+	}
+	defer h.Close()
+	if e = netlink.LinkSetNsFd(l, int(h.Fd())); e != nil {
+		return e
+	}
+	return h.Do(f)
+}
+func kernelDirectPair(t *testing.T) (*LinkVEth, *kernelDirectNode, *kernelDirectNode) {
+	t.Helper()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	original, e := netns.Get()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer original.Close()
+	defer func() {
+		if e := netns.Set(original); e != nil {
+			panic(e)
+		}
+	}()
+	a, e := netns.New()
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { a.Close() })
+	b, e := netns.New()
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { b.Close() })
+	na, nb := &kernelDirectNode{newFakeNode("kernel-a"), a}, &kernelDirectNode{newFakeNode("kernel-b"), b}
+	l := NewLinkVEth()
+	l.MTU = 9500
+	for i, n := range []*kernelDirectNode{na, nb} {
+		eg := NewEndpointGeneric(n, fmt.Sprintf("eth%d", i+1), l)
+		eg.MAC = net.HardwareAddr{2, 0, 0, 0, 0, byte(i + 1)}
+		eg.IfaceAlias = fmt.Sprintf("fixture alias/%d", i)
+		l.Endpoints = append(l.Endpoints, NewEndpointVeth(eg))
+	}
+	return l, na, nb
+}
+func TestDirectVethKernel(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("isolated kernel integration requires root")
+	}
+	for _, mode := range []string{"first", "both"} {
+		t.Run(mode, func(t *testing.T) {
+			l, a, b := kernelDirectPair(t)
+			l.SetDirectMode(mode)
+			ctx := context.Background()
+			if e := l.Deploy(ctx, l.Endpoints[0]); e != nil {
+				t.Fatal(e)
+			}
+			if mode == "first" {
+				if _, e := netlink.LinkByName(l.Endpoints[1].GetRandIfaceName()); e != nil {
+					t.Fatal("half-deployed host peer missing", e)
+				}
+			}
+			if e := l.Deploy(ctx, l.Endpoints[1]); e != nil {
+				t.Fatal(e)
+			}
+			if l.DeploymentState != LinkDeploymentStateFullDeployed {
+				t.Fatal("not fully deployed")
+			}
+			for i, n := range []*kernelDirectNode{a, b} {
+				e := n.ExecFunction(ctx, func(ns.NetNS) error {
+					ep := l.Endpoints[i]
+					link, e := netlink.LinkByName(ep.GetIfaceName())
+					if e != nil {
+						return e
+					}
+					attrs := link.Attrs()
+					if attrs.MTU != 9500 || attrs.HardwareAddr.String() != ep.GetMac().String() || attrs.Flags&net.FlagUp == 0 || attrs.Alias != ep.GetIfaceAlias() || len(attrs.AltNames) < 2 {
+						return fmt.Errorf("attributes not preserved: %+v", attrs)
+					}
+					out, e := exec.Command("ethtool", "-k", ep.GetIfaceName()).CombinedOutput()
+					if e != nil {
+						return fmt.Errorf("ethtool: %w: %s", e, out)
+					}
+					if !strings.Contains(string(out), "tx-checksumming: off") {
+						return fmt.Errorf("TX offload not disabled")
+					}
+					addr, _ := netlink.ParseAddr(fmt.Sprintf("192.0.2.%d/30", i+1))
+					return netlink.AddrAdd(link, addr)
+				})
+				if e != nil {
+					t.Fatal(e)
+				}
+			}
+			if e := a.ExecFunction(ctx, func(ns.NetNS) error {
+				out, e := exec.Command("ping", "-n", "-c", "1", "-W", "2", "192.0.2.2").CombinedOutput()
+				if e != nil {
+					return fmt.Errorf("ping: %w: %s", e, out)
+				}
+				return nil
+			}); e != nil {
+				t.Fatal(e)
+			}
+			if e := l.Remove(ctx); e != nil {
+				t.Fatal(e)
+			}
+			for i, n := range []*kernelDirectNode{a, b} {
+				if e := n.ExecFunction(ctx, func(ns.NetNS) error {
+					_, e := netlink.LinkByName(l.Endpoints[i].GetIfaceName())
+					if e == nil {
+						return fmt.Errorf("endpoint remains")
+					}
+					return nil
+				}); e != nil {
+					t.Fatal(e)
+				}
+			}
+			for _, ep := range l.Endpoints {
+				if _, e := netlink.LinkByName(ep.GetRandIfaceName()); e == nil {
+					t.Fatal("host peer leaked")
+				}
+			}
+		})
+	}
+
+	t.Run("transient-failure-rolls-back-and-retries", func(t *testing.T) {
+		l, a, b := kernelDirectPair(t)
+		l.SetDirectMode("both")
+		ctx := context.Background()
+		ops := kernelDirectVethOps()
+		originalSetup := ops.setup
+		originalAdd := ops.add
+		attempts := 0
+		failed := false
+		ops.add = func(v netlink.Link) error { attempts++; return originalAdd(v) }
+		ops.setup = func(link netlink.Link, ep Endpoint) func(ns.NetNS) error {
+			return func(current ns.NetNS) error {
+				if ep == l.Endpoints[1] && !failed {
+					failed = true
+					return syscall.EFAULT
+				}
+				return originalSetup(link, ep)(current)
+			}
+		}
+		l.directOps = ops
+		if e := l.Deploy(ctx, l.Endpoints[0]); e != nil {
+			t.Fatal(e)
+		}
+		if attempts != 2 || l.DeploymentState != LinkDeploymentStateFullDeployed {
+			t.Fatal("retry did not rebuild clean pair")
+		}
+		if e := l.Remove(ctx); e != nil {
+			t.Fatal(e)
+		}
+		for i, n := range []*kernelDirectNode{a, b} {
+			if e := n.ExecFunction(ctx, func(ns.NetNS) error {
+				_, e := netlink.LinkByName(l.Endpoints[i].GetIfaceName())
+				if e == nil {
+					return fmt.Errorf("endpoint remains after retry cleanup")
+				}
+				return nil
+			}); e != nil {
+				t.Fatal(e)
+			}
+		}
+	})
+	t.Run("collision-preserves-existing", func(t *testing.T) {
+		l, a, _ := kernelDirectPair(t)
+		l.SetDirectMode("both")
+		ctx := context.Background()
+		if e := a.ExecFunction(ctx, func(ns.NetNS) error {
+			return netlink.LinkAdd(&netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "eth1"}})
+		}); e != nil {
+			t.Fatal(e)
+		}
+		if e := l.Deploy(ctx, l.Endpoints[0]); e == nil {
+			t.Fatal("collision succeeded")
+		}
+		if e := a.ExecFunction(ctx, func(ns.NetNS) error {
+			link, e := netlink.LinkByName("eth1")
+			if e != nil {
+				return e
+			}
+			if link.Type() != "dummy" {
+				return fmt.Errorf("existing link replaced")
+			}
+			return nil
+		}); e != nil {
+			t.Fatal(e)
+		}
+	})
+}
