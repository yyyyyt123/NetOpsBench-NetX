+)
+
+type directStageCounters struct {
+	created, linked, post, exec, static atomic.Int32
+	total, staticTotal                  int32
+}
+
+type bootstrapStageNode struct {
+	*directStageNode
+	pending, peak *atomic.Int32
+	failWait      bool
+}
+
+func (n *bootstrapStageNode) WaitDirectVethStartup(ctx context.Context) error {
+	defer n.pending.Add(-1)
+	if n.failWait {
+		return errors.New("injected bootstrap failure")
+	}
+	return ctx.Err()
+}
+
+func TestDirectBootstrapBoundAndFailure(t *testing.T) {
+	for _, failWait := range []bool{false, true} {
+		var pending, peak, starts atomic.Int32
+		var nodes []*dm.DependencyNode
+		for i := 0; i < 80; i++ {
+			n := &bootstrapStageNode{directStageNode: &directStageNode{cfg: &clabtypes.NodeConfig{ShortName: fmt.Sprint(i), Stages: clabtypes.NewStages()}}, pending: &pending, peak: &peak, failWait: failWait}
+			nodes = append(nodes, dm.NewDependencyNode(n))
+		}
+		err := runDirectPostDeployLimit(context.Background(), 4, 32, nodes, func(context.Context, *dm.DependencyNode) error {
+			starts.Add(1)
+			a := pending.Add(1)
+			for p := peak.Load(); a > p; p = peak.Load() {
+				if peak.CompareAndSwap(p, a) {
+					break
+				}
+			}
+			return nil
+		})
+		if peak.Load() > 32 {
+			t.Fatalf("unbounded background bootstrap: %d", peak.Load())
+		}
+		if failWait {
+			if err == nil || starts.Load() > 32 {
+				t.Fatalf("started beyond the in-flight window after failure: %v %d", err, starts.Load())
+			}
+		} else if err != nil || starts.Load() != 80 || pending.Load() != 0 {
+			t.Fatalf("lost bootstrap work: %v %d %d", err, starts.Load(), pending.Load())
+		}
+	}
+}
+
+type directStageNode struct {
+	clabnodes.Node
+	cfg        *clabtypes.NodeConfig
+	counts     *directStageCounters
+	fail       string
+	execCalled atomic.Bool
+}
+
+func (n *directStageNode) Config() *clabtypes.NodeConfig { return n.cfg }
+func (n *directStageNode) GetShortName() string          { return n.cfg.ShortName }
+func (n *directStageNode) SupportsDirectVeth() bool      { return true }
+func (n *directStageNode) OpenDirectVethNamespace(context.Context) (ns.NetNS, error) {
+	return nil, errors.New("not used by scheduler test")
+}
+func (n *directStageNode) PreDeploy(context.Context, *clabnodes.PreDeployParams) error { return nil }
+func (n *directStageNode) Deploy(ctx context.Context, _ *clabnodes.DeployParams) error {
+	if n.fail == "create" {
+		return errors.New("injected create failure")
+	}
+	if n.cfg.MgmtIPv4Address != "" {
+		n.counts.static.Add(1)
+	} else if n.counts.static.Load() != n.counts.staticTotal {
+		return errors.New("dynamic node before static nodes")
+	}
+	n.counts.created.Add(1)
+	return nil
+}
+func (n *directStageNode) UpdateConfigWithRuntimeInfo(context.Context) error { return nil }
+func (n *directStageNode) DeployEndpoints(context.Context) error {
+	if n.counts.created.Load() != n.counts.total {
+		return errors.New("links before all namespaces")
+	}
+	if n.fail == "links" {
+		return errors.New("injected links failure")
+	}
+	n.counts.linked.Add(1)
+	return nil
+}
+func (n *directStageNode) PostDeploy(context.Context, *clabnodes.PostDeployParams) error {
+	if n.counts.linked.Load() != n.counts.total {
+		return errors.New("postdeploy before all links")
+	}
+	if n.fail == "post" {
+		return errors.New("injected post failure")
+	}
+	n.counts.post.Add(1)
+	return nil
+}
+func (n *directStageNode) RunExecFromConfig(context.Context, *clabexec.ExecCollection) error {
+	n.execCalled.Store(true)
+	n.counts.exec.Add(1)
+	return nil
+}
+func stageFixture(t *testing.T) (*CLab, *directStageCounters) {
+	t.Helper()
+	c, e := NewContainerLab()
+	if e != nil {
