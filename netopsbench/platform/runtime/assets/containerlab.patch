+)
+
+type stubDirectNS struct {
+	id     uintptr
+	closes int
+}
+
+func (n *stubDirectNS) Do(f func(ns.NetNS) error) error { return f(n) }
+func (n *stubDirectNS) Set() error                      { return nil }
+func (n *stubDirectNS) Path() string                    { return "stub" }
+func (n *stubDirectNS) Fd() uintptr                     { return n.id }
+func (n *stubDirectNS) Close() error                    { n.closes++; return nil }
+
+type stubDirectNode struct {
+	*fakeNode
+	space *stubDirectNS
+}
+
+func (n *stubDirectNode) SupportsDirectVeth() bool { return true }
+func (n *stubDirectNode) OpenDirectVethNamespace(context.Context) (ns.NetNS, error) {
+	return n.space, nil
+}
+func stubDirectLink() (*LinkVEth, *stubDirectNode, *stubDirectNode) {
+	l := NewLinkVEth()
+	l.MTU = 9500
+	a := &stubDirectNode{newFakeNode("a"), &stubDirectNS{id: 101}}
+	b := &stubDirectNode{newFakeNode("b"), &stubDirectNS{id: 102}}
+	l.Endpoints = []Endpoint{NewEndpointVeth(NewEndpointGeneric(a, "eth1", l)), NewEndpointVeth(NewEndpointGeneric(b, "eth2", l))}
+	return l, a, b
+}
+func TestDirectVethLifecycle(t *testing.T) {
+	for _, mode := range []string{"first", "both"} {
+		t.Run(mode, func(t *testing.T) {
+			l, a, b := stubDirectLink()
+			if !l.SetDirectMode(mode) {
+				t.Fatal("rejected")
+			}
+			added, removed, setups := 0, 0, 0
+			l.directOps = &directVethOps{
+				add: func(link netlink.Link) error {
+					added++
+					v := link.(*netlink.Veth)
+					if v.Name != "eth1" || v.Namespace != netlink.NsFd(101) || v.MTU != 9500 {
+						t.Fatalf("bad attrs: %+v", v)
+					}
+					if mode == "both" && (v.PeerName != "eth2" || v.PeerNamespace != netlink.NsFd(102)) {
+						t.Fatal("bad peer")
+					}
+					if mode == "first" && (v.PeerName != l.Endpoints[1].GetRandIfaceName() || v.PeerNamespace != nil) {
+						t.Fatal("peer must remain in host")
+					}
+					return nil
+				},
+				find: func(name string) (netlink.Link, error) {
+					return &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: name}}, nil
+				},
+				remove: func(netlink.Link) error { removed++; return nil }, txOff: func(string) error { return nil },
+				setup: func(_ netlink.Link, _ Endpoint) func(ns.NetNS) error {
+					return func(ns.NetNS) error { setups++; return nil }
+				},
+			}
+			if err := l.Deploy(context.Background(), l.Endpoints[0]); err != nil {
+				t.Fatal(err)
+			}
+			wantState, wantSetup := LinkDeploymentState(LinkDeploymentStateHalfDeployed), 1
+			if mode == "both" {
+				wantState, wantSetup = LinkDeploymentStateFullDeployed, 2
+				var wg sync.WaitGroup
+				for i := 0; i < 32; i++ {
+					wg.Add(1)
+					go func() {
+						defer wg.Done()
+						if err := l.Deploy(context.Background(), l.Endpoints[1]); err != nil {
+							t.Error(err)
+						}
+					}()
+				}
+				wg.Wait()
+			}
+			if l.DeploymentState != wantState || added != 1 || removed != 0 || setups != wantSetup || a.space.closes != 1 {
+				t.Fatal("invalid lifecycle", l.DeploymentState, added, removed, setups)
+			}
+			if mode == "both" && b.space.closes != 1 {
+				t.Fatal("peer handle leaked")
+			}
+		})
+	}
+}
+func TestDirectVethFailureRollback(t *testing.T) {
+	sentinel := errors.New("setup failed")
+	for _, failure := range []string{"collision", "setup-a", "setup-b", "cancel", "rollback"} {
+		t.Run(failure, func(t *testing.T) {
+			l, a, b := stubDirectLink()
+			l.SetDirectMode("both")
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			removed, calls := 0, 0
+			l.directOps = &directVethOps{
+				add: func(netlink.Link) error {
+					if failure == "collision" {
+						return syscall.EEXIST
+					}
+					return nil
+				},
+				find: func(name string) (netlink.Link, error) {
+					return &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: name}}, nil
+				},
+				remove: func(netlink.Link) error {
+					removed++
+					if failure == "rollback" {
+						return syscall.EFAULT
+					}
+					return nil
+				},
+				txOff: func(string) error {
+					if failure == "cancel" {
+						cancel()
+					}
+					return nil
+				},
+				setup: func(_ netlink.Link, _ Endpoint) func(ns.NetNS) error {
+					return func(ns.NetNS) error {
+						calls++
+						if failure == "setup-a" || failure == "rollback" || failure == "setup-b" && calls == 2 {
+							return sentinel
+						}
+						return nil
+					}
+				},
+			}
+			err := l.Deploy(ctx, l.Endpoints[0])
+			if err == nil {
+				t.Fatal("expected error")
+			}
+			if l.DeploymentState != LinkDeploymentStateNotDeployed || a.space.closes != 1 || b.space.closes != 1 {
+				t.Fatal("state or handle leak")
+			}
+			if failure == "collision" {
+				if removed != 0 || !errors.Is(err, syscall.EEXIST) {
+					t.Fatal("collision deleted existing interface")
+				}
+			} else if removed != 1 {
+				t.Fatal("rollback not once", removed)
+			}
+			if failure == "cancel" && !errors.Is(err, context.Canceled) {
+				t.Fatal(err)
+			}
+			if failure == "rollback" && isTransientNetlinkErr(err) {
+				t.Fatal("failed rollback must not retry")
+			}
+		})
+	}
+}
+func TestDirectVethCanceledBeforeMutation(t *testing.T) {
+	l, a, b := stubDirectLink()
+	l.SetDirectMode("first")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := l.Deploy(ctx, l.Endpoints[0]); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if a.space.closes != 0 || b.space.closes != 0 {
+		t.Fatal("opened namespace after cancellation")
+	}
+}
+func TestDirectVethEligibility(t *testing.T) {
+	l, _, _ := stubDirectLink()
+	l.Endpoints[0].SetIfaceName("this-name-is-far-too-long")
+	if l.SetDirectMode("first") {
+		t.Fatal("long name must use legacy")
+	}
+	l, _, _ = stubDirectLink()
+	l.Endpoints[0].SetNode(newFakeNode("custom"))
+	if l.SetDirectMode("first") {
+		t.Fatal("custom attach must use legacy")
+	}
+	l, _, _ = stubDirectLink()
+	if l.SetDirectMode("off") {
+		t.Fatal("disabled")
+	}
+}
