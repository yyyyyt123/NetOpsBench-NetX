+func TestHostsCrossProcess(t *testing.T) {
+	if dir := os.Getenv("CLAB_TEST_HOSTS_DIR"); dir != "" {
+		clabHostsFilename = filepath.Join(dir, "hosts")
+		clabHostsLockPath = filepath.Join(dir, "lock")
+		c := &CLab{Config: &Config{Name: os.Getenv("CLAB_TEST_LAB")}, Nodes: map[string]clabnodes.Node{}}
+		for i := 0; i < 10; i++ {
+			if err := c.appendHostsFileEntries(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return
+	}
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "hosts"), []byte("127.0.0.1 localhost\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	cmds := make([]*exec.Cmd, 4)
+	for i := range cmds {
+		cmds[i] = exec.Command(os.Args[0], "-test.run=^TestHostsCrossProcess$")
+		cmds[i].Env = append(os.Environ(), "CLAB_TEST_HOSTS_DIR="+dir, fmt.Sprintf("CLAB_TEST_LAB=lab%d", i))
+		if err := cmds[i].Start(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, cmd := range cmds {
+		if err := cmd.Wait(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	data, _ := os.ReadFile(filepath.Join(dir, "hosts"))
+	for i := range cmds {
+		if strings.Count(string(data), fmt.Sprintf("CLAB-lab%d-START", i)) != 1 {
+			t.Fatal("lost or duplicated lab")
+		}
+	}
+}
diff --git a/internal/mgmtlink/link.go b/internal/mgmtlink/link.go
new file mode 100644
--- /dev/null
+++ b/internal/mgmtlink/link.go
@@ -0,0 +1,268 @@
+// Scoped Containerlab-side management-veth prototype; Docker remains stock.
+package mgmtlink
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netns"
+)
+
+type Request struct {
+	Mode    string `json:"mode"`
+	PID     int    `json:"pid"`
+	Birth   string `json:"birth"`
+	Host    string `json:"host"`
+	Bridge  string `json:"bridge"`
+	CIDR    string `json:"cidr"`
+	Gateway string `json:"gateway"`
+	Alias   string `json:"alias"`
+}
+
+func Birth(pid int) (string, error) {
+	b, e := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if e != nil {
+		return "", e
+	}
+	i := strings.LastIndex(string(b), ")")
+	f := strings.Fields(string(b)[i+1:])
+	if len(f) < 20 {
+		return "", fmt.Errorf("bad proc stat")
+	}
+	return f[19], nil
+}
+func Run(r Request) (out map[string]interface{}, err error) {
+	if !strings.HasPrefix(r.Host, "nbm") || len(r.Host) > 15 || !strings.HasPrefix(r.Alias, "netopsbench-mgmt:") {
+		return nil, fmt.Errorf("invalid ownership marker")
+	}
+	// Serialize CLI initial attachment and asynchronous restart reconciliation.
+	if err := os.MkdirAll("/run/netopsbench-mgmt", 0700); err != nil {
+		return nil, err
+	}
+	lock, e := os.OpenFile(filepath.Join("/run/netopsbench-mgmt", r.Host+".lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if e != nil {
+		return nil, e
+	}
+	defer lock.Close()
+	if e = unix.Flock(int(lock.Fd()), unix.LOCK_EX); e != nil {
+		return nil, e
+	}
+	defer unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+	if r.Mode == "delete" {
+		l, e := netlink.LinkByName(r.Host)
+		if _, ok := e.(netlink.LinkNotFoundError); ok {
+			return map[string]interface{}{"absent": true}, nil
+		}
+		if e != nil {
+			return nil, e
+		}
+		if l.Attrs().Alias != r.Alias {
+			return nil, fmt.Errorf("ownership mismatch: got %q expected %q", l.Attrs().Alias, r.Alias)
+		}
+		return map[string]interface{}{"deleted": r.Host}, netlink.LinkDel(l)
+	}
+	ns, e := netns.GetFromPid(r.PID)
+	if e != nil {
+		return nil, e
+	}
+	defer ns.Close()
+	b, e := Birth(r.PID)
+	if e != nil || b != r.Birth {
+		return nil, fmt.Errorf("PID identity mismatch")
+	}
+	h, e := netlink.NewHandleAt(ns)
+	if e != nil {
+		return nil, e
+	}
+	defer h.Close()
+	if r.Mode == "inspect" {
+		p, e := h.LinkByName("eth0")
+		if e != nil {
+			return nil, e
+		}
+		a, e := h.AddrList(p, netlink.FAMILY_V4)
+		if e != nil {
+			return nil, e
+		}
+		routes, e := h.RouteList(p, netlink.FAMILY_V4)
+		if e != nil {
+			return nil, e
+		}
+		ips := []string{}
+		for _, x := range a {
+			ips = append(ips, x.IPNet.String())
+		}
+		gateways := []string{}
+		for _, x := range routes {
+			if isDefaultGateway(x) {
+				gateways = append(gateways, x.Gw.String())
+			}
+		}
+		return map[string]interface{}{"ips": ips, "gateways": gateways, "name": p.Attrs().Name, "mtu": p.Attrs().MTU, "tx_queues": p.Attrs().NumTxQueues, "rx_queues": p.Attrs().NumRxQueues, "up": p.Attrs().Flags&net.FlagUp != 0, "addresses": a, "routes": routes}, nil
+	}
+	if r.Mode == "ensure" {
+		// Existing eth0 must belong to this owner and carry exactly the requested address.
+		if peer, pe := h.LinkByName("eth0"); pe == nil {
+			host, he := netlink.LinkByName(r.Host)
+			addresses, ae := h.AddrList(peer, netlink.FAMILY_V4)
+			match := false
+			for _, a := range addresses {
+				if a.IPNet.String() == r.CIDR {
+					match = true
+				}
+			}
+			if he != nil || ae != nil || host.Attrs().Alias != r.Alias || peer.Attrs().Alias != r.Alias || !match {
+				return nil, fmt.Errorf("existing management interface does not match ownership/address")
+			}
+			return map[string]interface{}{"existing": true}, nil
+		}
+		// The old namespace may remain pinned by data links. Only remove our exact owned pair.
+		if host, he := netlink.LinkByName(r.Host); he == nil {
+			if host.Attrs().Alias != r.Alias {
+				return nil, fmt.Errorf("stale link ownership mismatch")
+			}
+			if e = netlink.LinkDel(host); e != nil {
+				return nil, e
+			}
+		} else if _, ok := he.(netlink.LinkNotFoundError); !ok {
+			return nil, he
+		}
+		r.Mode = "final-q1"
+	}
+	if r.Mode != "final-q1" && r.Mode != "final-default" && r.Mode != "rename-default" {
+		return nil, fmt.Errorf("invalid mode")
+	}
+	if !strings.HasPrefix(r.Bridge, "br-") {
+		return nil, fmt.Errorf("requires private Docker-created bridge")
+	}
+	bridge, e := netlink.LinkByName(r.Bridge)
+	if e != nil {
+		return nil, e
+	}
+	if bridge.Type() != "bridge" {
+		return nil, fmt.Errorf("not a bridge")
+	}
+	addr, e := netlink.ParseAddr(r.CIDR)
+	if e != nil {
+		return nil, e
+	}
+	gw := net.ParseIP(r.Gateway)
+	if gw == nil || !addr.IPNet.Contains(gw) {
+		return nil, fmt.Errorf("invalid gateway")
+	}
+	peer := "eth0"
+	if r.Mode == "rename-default" {
+		peer = "nbmpending"
+	}
+	v := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: r.Host, Alias: r.Alias, MTU: bridge.Attrs().MTU, TxQLen: 0, MasterIndex: bridge.Attrs().Index}, PeerName: peer, PeerNamespace: netlink.NsFd(ns), PeerHardwareAddr: stableMAC(r.Alias)}
+	if r.Mode == "final-q1" {
+		v.NumTxQueues = 1
+		v.NumRxQueues = 1
+		v.PeerNumTxQueues = 1
+		v.PeerNumRxQueues = 1
+	}
+	start := time.Now()
+	if e = netlink.LinkAdd(v); e != nil {
+		return nil, e
+	}
+	created := time.Now()
+	createdHost, e := netlink.LinkByName(r.Host)
+	if e != nil {
+		return nil, e
+	}
+	defer func() {
+		if err != nil {
+			if current, ce := netlink.LinkByName(r.Host); ce == nil && current.Attrs().Index == createdHost.Attrs().Index {
+				_ = netlink.LinkDel(current)
+			}
+		}
+	}()
+	if e = netlink.LinkSetAlias(createdHost, r.Alias); e != nil {
+		return nil, e
+	}
+
+	defer func() {
+		if err != nil {
+			if l, e := netlink.LinkByName(r.Host); e == nil && l.Attrs().Alias == r.Alias {
+				_ = netlink.LinkDel(l)
+			}
+		}
+	}()
+	p, e := h.LinkByName(peer)
+	if e != nil {
+		return nil, e
+	}
+	if e = h.LinkSetAlias(p, r.Alias); e != nil {
+		return nil, e
+	}
+	if peer != "eth0" {
+		if e = h.LinkSetName(p, "eth0"); e != nil {
+			return nil, e
+		}
+	}
+	renamed := time.Now()
+	if e = h.AddrAdd(p, addr); e != nil {
+		return nil, e
+	}
+	if e = h.LinkSetUp(p); e != nil {
+		return nil, e
+	}
+	lo, e := h.LinkByName("lo")
+	if e != nil {
+		return nil, e
+	}
+	if e = h.LinkSetUp(lo); e != nil {
+		return nil, e
+	}
+	if e = h.RouteAdd(&netlink.Route{LinkIndex: p.Attrs().Index, Gw: gw}); e != nil {
+		return nil, e
+	}
+	host, e := netlink.LinkByName(r.Host)
+	if e != nil {
+		return nil, e
+	}
+	if e = netlink.LinkSetAlias(host, r.Alias); e != nil {
+		return nil, e
+	}
+	host, e = netlink.LinkByName(r.Host)
+	if e != nil {
+		return nil, e
+	}
+	if host.Attrs().Alias != r.Alias {
+		return nil, fmt.Errorf("alias set failed: %q", host.Attrs().Alias)
+	}
+	if e = netlink.LinkSetUp(host); e != nil {
+		return nil, e
+	}
+	// Never change the state/options of an existing shared bridge.
+	p, e = h.LinkByName("eth0")
+	if e != nil {
+		return nil, e
+	}
+	return map[string]interface{}{"mode": r.Mode, "create_seconds": created.Sub(start).Seconds(), "rename_seconds": renamed.Sub(created).Seconds(), "configure_seconds": time.Since(renamed).Seconds(), "total_seconds": time.Since(start).Seconds(), "host": host.Attrs().Name, "peer": p.Attrs().Name, "host_tx": host.Attrs().NumTxQueues, "host_rx": host.Attrs().NumRxQueues, "peer_tx": p.Attrs().NumTxQueues, "peer_rx": p.Attrs().NumRxQueues, "mtu": p.Attrs().MTU, "master": host.Attrs().MasterIndex}, nil
+}
+func isDefaultGateway(r netlink.Route) bool {
+	if r.Gw == nil {
+		return false
+	}
+	if r.Dst == nil {
+		return true
+	}
+	ones, bits := r.Dst.Mask.Size()
+	return bits == 32 && ones == 0
+}
+
+// Stable L2 identity prevents stale neighbor entries after an automatic restart.
+func stableMAC(alias string) net.HardwareAddr {
+	sum := sha256.Sum256([]byte(alias))
+	mac := net.HardwareAddr(append([]byte(nil), sum[:6]...))
+	mac[0] = (mac[0] | 2) & 0xfe
+	return mac
+}
